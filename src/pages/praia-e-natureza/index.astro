---
import { getCollection } from 'astro:content';
import PillarLayout from '../../layouts/PillarLayout.astro';
import { publishable } from '../../utils/guides';
import { PILLARS } from '../../data/pillars';

const guides = publishable(await getCollection('articles'))
  .filter((a) => a.data.language === 'pt' && a.data.pillar === 'praia_natureza');
---
<PillarLayout
  lang="pt"
  content={PILLARS.pt.praia_natureza}
  guides={guides}
  canonicalPath="/praia-e-natureza/"
  alternateUrl="/en/beach-and-outdoors/"
/>
