---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import GuideList from '../../../components/place/GuideList.astro';
import { publishable } from '../../../utils/guides';
import PillarStub from '../../../components/layout/PillarStub.astro';

const guides = publishable(await getCollection('articles'))
  .filter((a) => a.data.language === 'en' && a.data.pillar === 'dormir');
---
<BaseLayout
  lang="en"
  title="Where to Stay · Margem Cool"
  description="Hotels, pousadas, agroturismo, guesthouses, quintas with rooms — where to stay in the Margem Sul."
  alternateUrl="/dormir/"
  canonicalPath="/en/where-to-stay/"
  noindex={guides.length === 0}
>
  {guides.length > 0 ? (
    <section class="pillar-guides">
      <div class="container container--wide">
        <GuideList lang="en" guides={guides} />
      </div>
    </section>
  ) : (
  <PillarStub
      lang="en"
      title="Where to Stay"
      dek="Hotels, pousadas, agroturismo, guesthouses, quintas with rooms — where to stay in the Margem Sul."
    />
  )}
</BaseLayout>

<style>
  .pillar-guides { padding: var(--space-xl) 0 var(--space-2xl); }
</style>
