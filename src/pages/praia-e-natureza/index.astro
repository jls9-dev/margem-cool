---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import GuideList from '../../components/place/GuideList.astro';
import { publishable } from '../../utils/guides';
import PillarStub from '../../components/layout/PillarStub.astro';

const guides = publishable(await getCollection('articles'))
  .filter((a) => a.data.language === 'pt' && a.data.pillar === 'praia_natureza');
---
<BaseLayout
  lang="pt"
  title="Praia & Natureza · Margem Cool"
  description="Praias, Arrábida, caminhadas, surf, locais de banho, o rio — o ar livre na Margem Sul."
  alternateUrl="/en/beach-and-outdoors/"
  canonicalPath="/praia-e-natureza/"
  noindex={guides.length === 0}
>
  {guides.length > 0 ? (
    <section class="pillar-guides">
      <div class="container container--wide">
        <GuideList lang="pt" guides={guides} />
      </div>
    </section>
  ) : (
  <PillarStub
      lang="pt"
      title="Praia & Natureza"
      dek="Praias, Arrábida, caminhadas, surf, locais de banho, o rio — o ar livre na Margem Sul."
    />
  )}
</BaseLayout>

<style>
  .pillar-guides { padding: var(--space-xl) 0 var(--space-2xl); }
</style>
