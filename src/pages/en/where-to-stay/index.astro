---
import { getCollection } from 'astro:content';
import PillarLayout from '../../../layouts/PillarLayout.astro';
import { publishable } from '../../../utils/guides';
import { PILLARS } from '../../../data/pillars';

const guides = publishable(await getCollection('articles'))
  .filter((a) => a.data.language === 'en' && a.data.pillar === 'dormir');
---
<PillarLayout
  lang="en"
  content={PILLARS.en.dormir}
  guides={guides}
  canonicalPath="/en/where-to-stay/"
  alternateUrl="/dormir/"
/>
