---
import { getCollection } from 'astro:content';
import PillarLayout from '../../layouts/PillarLayout.astro';
import { publishable } from '../../utils/guides';
import { PILLARS } from '../../data/pillars';

const guides = publishable(await getCollection('articles'))
  .filter((a) => a.data.language === 'pt' && a.data.pillar === 'dormir');
---
<PillarLayout
  lang="pt"
  content={PILLARS.pt.dormir}
  guides={guides}
  canonicalPath="/dormir/"
  alternateUrl="/en/where-to-stay/"
/>
