---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  lang="en"
  title="Analytics opt-out · Margem Cool"
  description="Exclude this browser from analytics on margemcool.pt."
  alternateUrl="/optout/"
  canonicalPath="/en/optout/"
  noindex={true}
>
  <main class="optout-shell" style="max-width:44rem;margin:0 auto;padding:clamp(3rem,8vw,5rem) 1.5rem;line-height:1.65">
    <p style="font-size:.75rem;letter-spacing:.14em;text-transform:uppercase;opacity:.55;margin:0 0 .85rem">Analytics opt-out</p>

    <h1 id="ox-title" style="font-size:clamp(1.6rem,4vw,2.4rem);line-height:1.2;margin:0 0 1rem;font-weight:600">Opting this browser out…</h1>

    <p id="ox-msg" style="margin:0 0 1.5rem">Setting a cookie on margemcool.pt so your visits stop being counted.</p>

    <p id="ox-progress" style="display:none;margin:0 0 1.5rem;font-variant-numeric:tabular-nums"></p>

    <p id="ox-action" style="display:none;margin:0 0 1.5rem">
      <a id="ox-action-link" href="/" style="display:inline-block;padding:.6rem 1rem;border:1px solid currentColor;text-decoration:none"></a>
    </p>

    <p id="ox-note" style="display:none;margin:0 0 2rem;opacity:.7;font-size:.9375rem"></p>

    <p style="margin:0"><a href="/">← Back to Margem Cool</a></p>
  </main>

  <script is:inline>
    (function () {
      // Every brand's opt-out page carries this same list. The chain handed in
      // by ?chain= is filtered against it, so a crafted link can only ever
      // bounce between our own domains — never off-site.
      var BRANDS = [["belverdedartsclub.com","Belverde Darts Club"],["bitsapp.co","BITS"],["frigilianaguide.com","Frigiliana Guide"],["infinitedarts.com","Infinite Darts"],["lisbonproperty.pt","Lisbon Property"],["margemcool.pt","Margem Cool"],["parts.fm","Parts"],["shrigurugita.com","Shri Guru Gita"],["southbank.pt","South Bank Real Estate"],["spandera.studio","Spandera Studio"],["truthwithoutborderspress.com","Truth Without Borders Press"]];
      var HOST = "margemcool.pt";
      var NAME = "Margem Cool";
      var T = {"failTitle":"Could not set the cookie","failMsg":"This browser blocked it — usually private mode or strict tracking protection. Try again in a normal window, or use a different browser.","failChain":"The run has stopped here. Skip this one and carry on:","note":"The cookie lasts 2 years. Safari on iPhone deletes it after 7 days without a visit, so repeat the run there now and then."};

      // JSDoc, not TypeScript: this script is is:inline, so it ships to the
      // browser exactly as written and must stay valid JS. The annotations are
      // here because one of the eleven repos runs astro check with strict on.
      /** @param {string} id */
      var $ = function (id) { return document.getElementById(id); };
      /** @param {string} id @param {string} s */
      var text = function (id, s) { var e = $(id); if (e) e.textContent = s; };
      /** @param {string} id @param {boolean} on */
      var show = function (id, on) { var e = $(id); if (e) e.style.display = on ? '' : 'none'; };

      var TOTAL = BRANDS.length;
      /** @type {Record<string, string>} */
      var nameOf = {};
      BRANDS.forEach(function (b) { nameOf[b[0]] = b[1]; });

      // Set, then read back. Never claim an opt-out that did not take.
      var twoYears = 60 * 60 * 24 * 365 * 2;
      document.cookie = 'spandera-staff=1; Path=/; Max-Age=' + twoYears + '; SameSite=Lax; Secure';
      var ok = document.cookie.split(';').some(function (c) {
        return c.trim().indexOf('spandera-staff=1') === 0;
      });

      var params = new URLSearchParams(location.search);
      var inChain = params.has('chain');
      var chain = (params.get('chain') || '').split(',')
        .map(function (s) { return s.trim().toLowerCase(); })
        .filter(function (s) { return s && nameOf[s] && s !== HOST; });

      /** @param {string[]} list */
      var hop = function (list) {
        return 'https://' + list[0] + '/optout/?chain=' + encodeURIComponent(list.slice(1).join(','));
      };

      /** @param {string} href @param {string} label */
      var action = function (href, label) {
        var a = /** @type {HTMLAnchorElement|null} */ ($('ox-action-link'));
        if (!a) return;
        a.href = href;
        a.textContent = label;
        show('ox-action', true);
      };

      show('ox-note', true);
      text('ox-note', T.note);

      if (!ok) {
        text('ox-title', T.failTitle);
        text('ox-msg', T.failMsg);
        if (chain.length) {
          text('ox-progress', T.failChain);
          show('ox-progress', true);
          action(hop(chain), "Continue to %s →".replace('%s', nameOf[chain[0]]));
        }
        return;
      }

      if (inChain && chain.length) {
        var done = TOTAL - chain.length;
        var nextName = nameOf[chain[0]];
        text('ox-title', "✓ %s — opted out".replace('%s', NAME));
        text('ox-msg', '');
        show('ox-msg', false);
        text('ox-progress', "%d of %t done in this browser. Going to %n…"
          .replace('%d', String(done)).replace('%t', String(TOTAL)).replace('%n', nextName));
        show('ox-progress', true);
        action(hop(chain), "Continue to %s →".replace('%s', nextName));
        // replace() so the back button does not walk back through the run.
        setTimeout(function () { location.replace(hop(chain)); }, 550);
        return;
      }

      if (inChain) {
        text('ox-title', "✓ All %t brands — this browser is finished".replace('%t', String(TOTAL)));
        text('ox-msg', "None of our sites will count visits from this browser. Every other browser and device you use still needs its own run — your phone is separate from your laptop, and Chrome is separate from Safari on the same machine.");
        return;
      }

      // Landed here directly — one brand only. Offer the full run.
      var rest = BRANDS.map(function (b) { return b[0]; }).filter(function (h) { return h !== HOST; });
      text('ox-title', "✓ %s — this browser is opted out".replace('%s', NAME));
      text('ox-msg', "That covers %s only. The other %r brands each need their own cookie, because a cookie cannot be shared across domains.".replace('%s', NAME).replace('%r', String(rest.length)));
      action(hop(rest), "Opt out of all %t brands in this browser →".replace('%t', String(TOTAL)));
    })();
  </script>
</BaseLayout>
