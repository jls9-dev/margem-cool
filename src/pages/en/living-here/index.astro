---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import GuideList from '../../../components/place/GuideList.astro';
import { publishable } from '../../../utils/guides';
import PillarStub from '../../../components/layout/PillarStub.astro';

const guides = publishable(await getCollection('articles'))
  .filter((a) => a.data.language === 'en' && a.data.pillar === 'viver_aqui');
---
<BaseLayout
  lang="en"
  title="Living Here · Margem Cool"
  description="Bureaucracy, schools, healthcare, transport, shopping, gardens, daily life — living in the Margem Sul."
  alternateUrl="/viver-aqui/"
  canonicalPath="/en/living-here/"
  noindex={guides.length === 0}
>
  {guides.length > 0 ? (
    <section class="pillar-guides">
      <div class="container container--wide">
        <GuideList lang="en" guides={guides} />
      </div>
    </section>
  ) : (
  <PillarStub
      lang="en"
      title="Living Here"
      dek="Bureaucracy, schools, healthcare, transport, shopping, gardens, daily life — living in the Margem Sul."
    />
  )}
</BaseLayout>

<style>
  .pillar-guides { padding: var(--space-xl) 0 var(--space-2xl); }
</style>
