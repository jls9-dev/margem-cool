---
import { getCollection } from 'astro:content';
import PillarLayout from '../../../layouts/PillarLayout.astro';
import { publishable } from '../../../utils/guides';
import { PILLARS } from '../../../data/pillars';

const guides = publishable(await getCollection('articles'))
  .filter((a) => a.data.language === 'en' && a.data.pillar === 'comer_beber');
---
<PillarLayout
  lang="en"
  content={PILLARS.en.comer_beber}
  guides={guides}
  canonicalPath="/en/eat-and-drink/"
  alternateUrl="/comer-e-beber/"
/>
