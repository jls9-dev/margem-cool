---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import GuideList from '../../../components/place/GuideList.astro';
import { publishable } from '../../../utils/guides';
import PillarStub from '../../../components/layout/PillarStub.astro';

const guides = publishable(await getCollection('articles'))
  .filter((a) => a.data.language === 'en' && a.data.pillar === 'comer_beber');
---
<BaseLayout
  lang="en"
  title="Eat & Drink · Margem Cool"
  description="Restaurants, tascas, pastelarias, padarias, markets — where and what to eat and drink in the Margem Sul."
  alternateUrl="/comer-e-beber/"
  canonicalPath="/en/eat-and-drink/"
  noindex={guides.length === 0}
>
  {guides.length > 0 ? (
    <section class="pillar-guides">
      <div class="container container--wide">
        <GuideList lang="en" guides={guides} />
      </div>
    </section>
  ) : (
  <PillarStub
      lang="en"
      title="Eat & Drink"
      dek="Tascas, restaurants, pastelarias, padarias, markets — where and what to eat and drink in the Margem Sul."
    />
  )}
</BaseLayout>

<style>
  .pillar-guides { padding: var(--space-xl) 0 var(--space-2xl); }
</style>
