---
import { getCollection } from 'astro:content';
import PillarLayout from '../../../layouts/PillarLayout.astro';
import { publishable } from '../../../utils/guides';
import { PILLARS } from '../../../data/pillars';

const guides = publishable(await getCollection('articles'))
  .filter((a) => a.data.language === 'en' && a.data.pillar === 'cultura_agenda');
---
<PillarLayout
  lang="en"
  content={PILLARS.en.cultura_agenda}
  guides={guides}
  canonicalPath="/en/culture-and-whats-on/"
  alternateUrl="/cultura-e-agenda/"
/>
