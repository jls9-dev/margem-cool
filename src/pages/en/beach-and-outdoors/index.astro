---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import GuideList from '../../../components/place/GuideList.astro';
import { publishable } from '../../../utils/guides';
import PillarStub from '../../../components/layout/PillarStub.astro';

const guides = publishable(await getCollection('articles'))
  .filter((a) => a.data.language === 'en' && a.data.pillar === 'praia_natureza');
---
<BaseLayout
  lang="en"
  title="Beach & Outdoors · Margem Cool"
  description="Beaches, the Arrábida, walking and hiking, surf, swimming spots, the river — outdoors in the Margem Sul."
  alternateUrl="/praia-e-natureza/"
  canonicalPath="/en/beach-and-outdoors/"
  noindex={guides.length === 0}
>
  {guides.length > 0 ? (
    <section class="pillar-guides">
      <div class="container container--wide">
        <GuideList lang="en" guides={guides} />
      </div>
    </section>
  ) : (
  <PillarStub
      lang="en"
      title="Beach & Outdoors"
      dek="Beaches, the Arrábida, walking and hiking, surf, swimming spots, the river — outdoors in the Margem Sul."
    />
  )}
</BaseLayout>

<style>
  .pillar-guides { padding: var(--space-xl) 0 var(--space-2xl); }
</style>
