---
import BaseLayout from '../../../layouts/BaseLayout.astro';

// Standalone by design. This page names no other site and links to none.
// The previous version shipped a hardcoded list of every domain in the network
// so the browser could be walked across all of them in one run; that list was
// readable by anyone who opened the page source, which is a disclosure, not a
// convenience. The one-run version now lives behind Cloudflare Access in the
// operations console, which is the only place that holds the list.
//
// The cookie name is deliberately generic for the same reason: a name carrying
// the network's name would identify the network in devtools and in this source,
// which ships verbatim.
---
<BaseLayout
  lang="en"
  title="Analytics opt-out · Margem Cool"
  description="Exclude this browser from analytics on margemcool.pt."
  alternateUrl="/optout/"
  canonicalPath="/en/optout/"
  noindex={true}
>
  <main class="optout-shell" style="max-width:44rem;margin:0 auto;padding:clamp(3rem,8vw,5rem) 1.5rem;line-height:1.65">
    <p style="font-size:.75rem;letter-spacing:.14em;text-transform:uppercase;opacity:.55;margin:0 0 .85rem">Analytics opt-out</p>

    <h1 id="ox-title" style="font-size:clamp(1.6rem,4vw,2.4rem);line-height:1.2;margin:0 0 1rem;font-weight:600">Opting this browser out…</h1>

    <p id="ox-msg" style="margin:0 0 1.5rem">Setting a cookie on margemcool.pt so your visits stop being counted.</p>

    <p id="ox-note" style="display:none;margin:0 0 2rem;opacity:.7;font-size:.9375rem"></p>

    <p style="margin:0"><a href="/">← Back to Margem Cool</a></p>
  </main>

  <script is:inline>
    (function () {
      // One cookie, this domain, nothing else.
      // JSDoc, not TypeScript: this script is is:inline and ships to the browser
      // exactly as written, so it must stay valid JS. The annotations are here
      // because one of these repos runs astro check with strict on.
      /** @param {string} id */
      var $ = function (id) { return document.getElementById(id); };
      /** @param {string} id @param {string} s */
      var text = function (id, s) { var e = $(id); if (e) e.textContent = s; };
      /** @param {string} id @param {boolean} on */
      var show = function (id, on) { var e = $(id); if (e) e.style.display = on ? '' : 'none'; };

      // Set, then read back. Never claim an opt-out that did not take.
      var twoYears = 60 * 60 * 24 * 365 * 2;
      document.cookie = 'analytics-optout=1; Path=/; Max-Age=' + twoYears + '; SameSite=Lax; Secure';
      var ok = document.cookie.split(';').some(function (c) {
        return c.trim().indexOf('analytics-optout=1') === 0;
      });

      show('ox-note', true);
      text('ox-note', 'The cookie lasts 2 years. Safari on iPhone deletes it after 7 days without a visit, so come back now and then.');

      if (!ok) {
        text('ox-title', 'Could not set the cookie');
        text('ox-msg', 'This browser blocked it — usually private mode or strict tracking protection. Try again in a normal window, or use a different browser.');
        return;
      }

      text('ox-title', '✓ Margem Cool — this browser is opted out');
      text('ox-msg', 'Every other browser and device you use needs its own visit to this page: your phone is separate from your laptop, and Chrome is separate from Safari on the same machine.');
    })();
  </script>
</BaseLayout>
