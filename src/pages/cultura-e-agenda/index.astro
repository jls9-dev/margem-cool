---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import GuideList from '../../components/place/GuideList.astro';
import { publishable } from '../../utils/guides';
import PillarStub from '../../components/layout/PillarStub.astro';

const guides = publishable(await getCollection('articles'))
  .filter((a) => a.data.language === 'pt' && a.data.pillar === 'cultura_agenda');
---
<BaseLayout
  lang="pt"
  title="Cultura & Agenda · Margem Cool"
  description="Festas, feiras, concertos, exposições, colectividades, procissões — a vida cultural recorrente da Margem Sul."
  alternateUrl="/en/culture-and-whats-on/"
  canonicalPath="/cultura-e-agenda/"
  noindex={guides.length === 0}
>
  {guides.length > 0 ? (
    <section class="pillar-guides">
      <div class="container container--wide">
        <GuideList lang="pt" guides={guides} />
      </div>
    </section>
  ) : (
  <PillarStub
      lang="pt"
      title="Cultura & Agenda"
      dek="Festas, feiras, concertos, exposições, colectividades, procissões — a vida cultural recorrente da Margem Sul."
    />
  )}
</BaseLayout>

<style>
  .pillar-guides { padding: var(--space-xl) 0 var(--space-2xl); }
</style>
